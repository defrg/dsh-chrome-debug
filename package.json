{
  "name": "dsh-chrome-debug",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：把 Chrome 调试能力（CDP）接成工具，并能自行启动调试模式的 Chrome（--remote-debugging-port / --user-data-dir）。零第三方依赖，只用 Node 内置 fetch + WebSocket。 | DSH plugin: drive Chrome over CDP and launch it in debug mode.",
  "license": "MIT",
  "author": "defrg (https://github.com/defrg)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defrg/dsh-chrome-debug.git"
  },
  "homepage": "https://github.com/defrg/dsh-chrome-debug#readme",
  "bugs": {
    "url": "https://github.com/defrg/dsh-chrome-debug/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cdp": "./lib/cdp.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "chrome",
    "cdp",
    "devtools-protocol",
    "automation",
    "debugging"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0",
    "node": "^22.15.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  }
}
