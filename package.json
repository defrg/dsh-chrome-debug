{
  "name": "dsh-chrome-debug",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：把 Chrome 调试能力（CDP）接成工具，并能自行启动调试模式的 Chrome（--remote-debugging-port / --user-data-dir）。运行期只用 Node 内置 fetch + WebSocket；仅用 schemastery 生成设置表单。 | DSH plugin: drive Chrome over CDP and launch it in debug mode.",
  "license": "MIT",
  "author": "defrg (https://github.com/defrg)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defrg/dsh-chrome-debug.git"
  },
  "homepage": "https://github.com/defrg/dsh-chrome-debug#readme",
  "bugs": {
    "url": "https://github.com/defrg/dsh-chrome-debug/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "scripts": {
    "check": "node scripts/check-config.mjs && node scripts/check-route-auth.mjs && node scripts/check-launch-args.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:route-auth": "node scripts/check-route-auth.mjs",
    "check:launch-args": "node scripts/check-launch-args.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./cdp": "./lib/cdp.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "chrome",
    "cdp",
    "devtools-protocol",
    "automation",
    "debugging"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0",
    "node": "^22.15.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
